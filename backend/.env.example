# ============================================================
# DAYFLOW HRMS — Backend Environment Variables
# Copy to backend/.env and fill in real values
# ============================================================

# Database
DATABASE_URL=postgresql://dayflow_user:changeme@db:5432/dayflow
DB_PASSWORD=changeme

# Auth / JWT
JWT_SECRET_KEY=replace-with-a-very-long-random-secret-string-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_NAME=Dayflow HRMS
EMAILS_FROM_ADDRESS=your-email@example.com
EMAILS_ENABLED=false

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# File storage
STORAGE_BACKEND=local
UPLOAD_DIR=/app/uploads

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
